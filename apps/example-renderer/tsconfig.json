{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "jsx": "react-jsx",
    "jsxImportSource": "@faux-ui/reconciler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.test.ts",
    "vite.config.ts"
  ],
  "references": [
    { "path": "../../packages/reconciler" },
    { "path": "../../packages/core" },
    { "path": "../../packages/renderer" }
  ]
}
