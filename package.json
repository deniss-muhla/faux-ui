{
  "name": "faux-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Deterministic terminal-first React UI with a browser mirror",
  "license": "MIT",
  "repository": "github:deniss-muhla/faux-ui",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && bun run --cwd apps/example build",
    "clean": "rm -rf packages/*/dist apps/*/dist coverage test-results",
    "typecheck": "tsc -b tsconfig.json --pretty false && tsc -p tsconfig.test.json --noEmit --pretty false",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "test:package": "bun scripts/test-package.mjs",
    "audit": "bun audit",
    "check": "bun run audit && bun run typecheck && bun run test && bun run test:browser && bun run test:package && bun run build",
    "example:dom": "bun run --cwd apps/example dev:dom",
    "example:build": "bun run --cwd apps/example build",
    "example:tui": "bun run --cwd apps/example dev:tui",
    "unicode:generate": "node scripts/generate-unicode-data.mjs",
    "benchmark": "bun scripts/benchmark.ts"
  },
  "overrides": {
    "picomatch": "4.0.5",
    "tinyglobby": "0.2.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-reconciler": "^0.33.0",
    "fast-check": "^4.9.0",
    "react": "^19.2.8",
    "react-reconciler": "^0.33.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
