{
  "name": "faux-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Functional Axial User Interface",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf packages/*/dist coverage",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-reconciler": "^0.33.0",
    "fast-check": "^4.0.0",
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "scheduler": "^0.27.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
