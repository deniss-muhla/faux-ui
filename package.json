{
  "name": "faux-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Functional Axial User Interface",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*",
    "design-system/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf packages/*/dist design-system/*/dist apps/*/dist coverage",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "vitest run",
    "test:visual": "bun run test:visual:dom && bun run test:visual:tui",
    "test:visual:dom": "playwright test",
    "test:visual:tui": "vitest run packages/render-tui/test/tui.visual.test.ts apps/example/test/example-tui.visual.test.ts",
    "test:watch": "vitest",
    "check": "bun run typecheck && bun run test",
    "example:dom": "bun run --cwd apps/example dev:dom",
    "example:build": "bun run --cwd apps/example build",
    "example:preview": "bun run --cwd apps/example preview",
    "gallery:dom": "bun run --cwd apps/design-system-gallery dev:dom",
    "gallery:build": "bun run --cwd apps/design-system-gallery build",
    "gallery:preview": "bun run --cwd apps/design-system-gallery preview",
    "example-renderer:dom": "bun run --cwd apps/example-renderer dev:dom",
    "example-renderer:build": "bun run --cwd apps/example-renderer build",
    "example-renderer:preview": "bun run --cwd apps/example-renderer preview",
    "example:tui": "bun run --cwd apps/example dev:tui",
    "example:tui:watch": "bun run --cwd apps/example dev:tui:watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.2",
    "@types/react-reconciler": "^0.33.0",
    "fast-check": "^4.0.0",
    "react": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "scheduler": "^0.27.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.5",
    "vitest": "^3.0.0"
  }
}
