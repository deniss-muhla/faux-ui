{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@faux-ui/ui": ["./packages/ui/src/index.ts"],
      "@faux-ui/ui/dom": ["./packages/ui/src/dom.ts"],
      "@faux-ui/ui/tui": ["./packages/ui/src/tui.ts"],
      "@faux-ui/ui/testing": ["./packages/ui/src/testing.ts"],
      "@faux-ui/ui/jsx-runtime": ["./packages/ui/src/jsx-runtime.ts"],
      "@faux-ui/ui/jsx-dev-runtime": ["./packages/ui/src/jsx-dev-runtime.ts"]
    }
  }
}
